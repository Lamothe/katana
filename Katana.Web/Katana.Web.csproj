<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup><ProjectReference Include="../Katana.Runtime/Katana.Runtime.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="UI/**" />
    <Content Remove="UI/**;wwwroot/**" />
    <None Remove="UI/node_modules/**" />
    <Watch Include="UI/src/**;UI/index.html" />
  </ItemGroup>
  <Target Name="BuildUI" BeforeTargets="BeforeBuild" Condition="'$(SkipUIBuild)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="UI" Condition="!Exists('UI/node_modules/.package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="UI" />
  </Target>
  <Target Name="IncludeBuiltUI" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths" DependsOnTargets="BuildUI">
    <ItemGroup>
      <Content Remove="wwwroot/**" />
      <Content Include="wwwroot/**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
